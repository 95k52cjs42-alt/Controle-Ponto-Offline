# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env (ele ja esta no .gitignore).
# Em desenvolvimento use development; em producao use production.
APP_ENV=development
# Producao exige HTTPS, PUBLIC_BASE_URL, TRUSTED_HOSTS e COOKIE_SECURE=true.
PUBLIC_BASE_URL=http://localhost:5000
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
# Ative somente se o proxy remover e sanitizar headers X-Forwarded-*.
TRUST_PROXY_HEADERS=false
# A importacao nunca cria tabelas; rode `flask --app app init-db` no deploy.
AUTO_INIT_DB=false
SECRET_KEY=troque-por-uma-chave-aleatoria-segura-com-pelo-menos-32-caracteres

# Chave de API do Resend para envio de e-mails (opcional)
RESEND_API_KEY=re_xxx
MAIL_FROM=onboarding@resend.dev

# URL do banco de dados. Padrao local SQLite:
DATABASE_URL=sqlite:///ponto.db
# Exemplo para PostgreSQL/Heroku:
# DATABASE_URL=postgresql://usuario:senha@host:5432/dbname
