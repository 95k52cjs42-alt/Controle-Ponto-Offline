# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env (ele ja esta no .gitignore).

# Chave secreta do Flask (obrigatorio em producao - gere uma forte)
SECRET_KEY=troque-por-uma-chave-aleatoria-segura

# Chave de API do Resend para envio de e-mails (opcional)
RESEND_API_KEY=re_xxx

# URL do banco de dados. Padrao local SQLite:
DATABASE_URL=sqlite:///ponto.db
# Exemplo para PostgreSQL/Heroku:
# DATABASE_URL=postgresql://usuario:senha@host:5432/dbname
